# Salin berkas ini menjadi .env lalu isi nilainya.
# Ambil dari Firebase Console > Project settings > General > Your apps > Web app (SDK setup and configuration).
# Nilai-nilai ini aman berada di kode browser; yang melindungi data adalah database.rules.json.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nama-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nama-project
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Alamat Realtime Database: Firebase Console > Build > Realtime Database > Data (tampil di bagian atas).
# Bentuknya bergantung pada lokasi database, jadi salin persis dari sana.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://nama-project-default-rtdb.asia-southeast1.firebasedatabase.app

# Opsional: isi true untuk memakai Firebase Emulator di komputer sendiri (lihat README).
# Mode emulator mengabaikan semua nilai di atas dan tidak menyentuh project Firebase sungguhan.
# NEXT_PUBLIC_FIREBASE_EMULATOR=true
