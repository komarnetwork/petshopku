/*
  Petshopku - aturan keamanan Firebase Realtime Database.
  Semua aturan akses dijaga di sini (di sisi server), bukan hanya di tampilan.

  Peran (profiles/{uid}/role): admin mengelola seluruh data; doctor hanya melihat pasien yang ia tangani.
  Akun yang belum disetujui dan pengguna yang belum login tidak punya akses ke data apa pun.

  Realtime Database tidak menyaring data diam-diam: kueri yang BISA mengembalikan data terlarang ditolak.
  Karena itu dokter membaca janji temu, konsultasi, vaksinasi, dan pemeriksaan hanya lewat kueri
  orderByChild('doctor_id').equalTo(uid), dan membaca pasien lewat daftar doctor_access/{uid}/pets.

  Dokter menandai janji temunya selesai langsung (dengan tanggal dan jam selesai), baik lewat hasil
  konsultasi maupun persetujuan vaksinasi / pemeriksaan terkait; ia juga menolak usulannya sendiri. Tidak ada
  jawaban pemilik karena pemilik tidak punya akun.
*/
{
  "rules": {
    "profiles": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui'",
      ".indexOn": [
        "approval_status",
        "role"
      ],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui'))",
        ".write": "(auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui') || (auth != null && auth.uid === $uid && !data.exists() && newData.child('role').val() === 'doctor' && newData.child('approval_status').val() === 'menunggu' && newData.child('email').val() === auth.token.email && !newData.child('license_number').exists() && !newData.child('approved_at').exists() && !newData.child('approved_by').exists() && !newData.child('rejected_at').exists() && !newData.child('rejected_by').exists() && !newData.child('rejection_reason').exists())",
        "full_name": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "phone": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "updated_at": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "role": {
          ".validate": "newData.val() === 'admin' || newData.val() === 'doctor'"
        },
        "approval_status": {
          ".validate": "newData.val() === 'menunggu' || newData.val() === 'disetujui' || newData.val() === 'ditolak'"
        }
      }
    },
    "services": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui'",
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui'",
      ".indexOn": [
        "type"
      ],
      "$id": {
        "price": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "pets": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui'",
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui'",
      "$id": {
        ".read": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'doctor' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui' && root.child('doctor_access').child(auth.uid).child('pets').child($id).val() === true"
      }
    },
    "doctor_access": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui'",
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "appointments": {
      ".read": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui' || (auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'doctor' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui' && query.orderByChild === 'doctor_id' && query.equalTo === auth.uid)",
      ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'admin' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui'",
      ".indexOn": [
        "doctor_id",
        "pet_id"
      ],
      "$id": {
        ".read": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'doctor' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui' && data.child('doctor_id').val() === auth.uid",
        "doctor_archived_at": {
          ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'doctor' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui' && data.parent().child('doctor_id').val() === auth.uid"
        },
        "updated_at": {
          ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'doctor' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui' && data.parent().child('doctor_id').val() === auth.uid"
        },
        "status": {
          ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'doctor' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui' && data.parent().child('doctor_id').val() === auth.uid && data.val() === 'dijadwalkan' && newData.val() === 'selesai' && newData.parent().child('completed_at').isString()",
          ".validate": "newData.val() === 'dijadwalkan' || newData.val() === 'selesai' || newData.val() === 'dibatalkan'"
        },
        "completed_at": {
          ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'doctor' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui' && data.parent().child('doctor_id').val() === auth.uid && data.parent().child('status').val() === 'dijadwalkan' && newData.parent().child('status').val() === 'selesai' && newData.isString()"
        },
        "vaccination_id": {
          ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'doctor' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui' && data.parent().child('doctor_id').val() === auth.uid && data.parent().child('status').val() === 'dijadwalkan' && newData.parent().child('status').val() === 'selesai' && newData.parent().parent().parent().child('vaccinations').child(newData.val()).child('appointment_id').val() === $id && newData.parent().parent().parent().child('vaccinations').child(newData.val()).child('doctor_id').val() === auth.uid && newData.parent().parent().parent().child('vaccinations').child(newData.val()).child('status').val() === 'dikonfirmasi'"
        },
        "examination_id": {
          ".write": "auth != null && root.child('profiles').child(auth.uid).child('role').val() === 'doctor' && root.child('profiles').child(auth.uid).child('approval_status').val() === 'disetujui' && data.parent().child('doctor_id').val() === auth.uid && data.parent().child('status').val() === 'dijadwalkan' && newData.parent().child('status').val() === 'selesai' && newData.parent().parent().parent().child('examinations').child(newData.val()).child('appointment_id').val() === $id && newData.parent().parent().parent().child('examinations').child(newData.val()).child('doctor_id').val() === auth.uid && newData.parent().parent().parent().child('examinations').child(newData.val()).child('status').val() === 'dikonfirmasi'"
        },
        "estimated_price": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    }
  }
}
